# Configuración común para load_data.py y run.sh

# Keycloak
KEYCLOAK_BASE_URL=https://keycloak-statsuite.dev.aws.fao.org/realms/statsuite
KEYCLOAK_OPENID_URL=${KEYCLOAK_BASE_URL}/.well-known/openid-configuration
KEYCLOAK_TOKEN_URL=${KEYCLOAK_BASE_URL}/protocol/openid-connect/token
KEYCLOAK_CLIENT_ID=stat-suite
KEYCLOAK_USER=test-admin
KEYCLOAK_PASSWORD=admin

# StatSuite
# DATASPACE puede sobrescribirse desde el entorno (o con el 2º parámetro de run.sh)
DATASPACE=${DATASPACE:-staging}
TRANSFER_URL=https://transfer-statsuite.dev.aws.fao.org
NSI_URL=https://nsi-${DATASPACE}-statsuite.dev.aws.fao.org

# k6
DOCKER_IMAGE=grafana/k6:latest
